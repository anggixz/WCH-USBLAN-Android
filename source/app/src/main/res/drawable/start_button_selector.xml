<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <size android:height="@dimen/dp_160" android:width="@dimen/dp_160"/>
            <solid android:color="@color/color_main_dark"/>
            <corners android:radius="@dimen/dp_90"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <size android:height="@dimen/dp_160" android:width="@dimen/dp_160"/>
            <solid android:color="@color/button_disenable"/>
            <corners android:radius="@dimen/dp_90"/>
        </shape>
    </item>
    <item>
        <shape>
            <size android:height="@dimen/dp_160" android:width="@dimen/dp_160"/>
            <solid android:color="@color/color_main"/>
            <corners android:radius="@dimen/dp_90"/>
        </shape>
    </item>
</selector>
