<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="12dp"/>
            <solid android:color="@color/color_main_subtle"/>
            <stroke android:width="1dp" android:color="@color/color_main_light"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp"/>
            <solid android:color="@color/fragment_background"/>
            <stroke android:width="1dp" android:color="@color/card_border"/>
        </shape>
    </item>
</selector>
